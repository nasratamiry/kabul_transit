# Only what is needed to build, run and maintain the system goes to GitHub.
# Classification of every path: docs/GO_LIVE.md («فایل‌ها»).

# Secrets: every .env file except the examples
.env
.env.*
!.env.example
!.env.production.example
!frontend/.env.example

# Python / Node build output and environments
.venv/
__pycache__/
*.pyc
node_modules/
dist/
/staticfiles/
*.sqlite3

# Runtime data: never in Git (uploaded documents, logs, database backups and dumps)
/media/
logs/
backups/
*.sql.gz

# Local only: moved-aside files, stage reports, screenshots, test output
_local/
/STAGE_*_COMPLETE.md
/*_COMPLETE.md
stage*_screenshots/
*_screenshots/
/checks-output/

# Local developer tooling (assistant / editor settings, code-navigation index)
graphify-out/
.claude/
.cursor/
.vscode/
.idea/
