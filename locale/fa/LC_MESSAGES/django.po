# Dari labels for django-simple-history (the package ships no Persian/Dari translation).
# Compile to django.mo with: python manage.py compilemessages  (needs GNU gettext)
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: fa\n"
"Plural-Forms: nplurals=2; plural=(n > 1);\n"

msgid "View history: %s"
msgstr "مشاهده تاریخچه: %s"

msgid "Change history: %s"
msgstr "تاریخچه تغییرات: %s"

msgid "The %(name)s \"%(obj)s\" was changed successfully."
msgstr "%(name)s «%(obj)s» با موفقیت تغییر کرد."

