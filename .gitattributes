# Files that run inside Linux containers or are read by Linux tools must keep LF line endings,
# also when the repository is checked out on Windows (a CRLF shebang breaks the container).
*.sh                text eol=lf
Dockerfile          text eol=lf
*.dockerignore      text eol=lf
.dockerignore       text eol=lf
deploy/**           text eol=lf
docker-compose*.yml text eol=lf
*.ps1               text eol=crlf
