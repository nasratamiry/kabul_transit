# --- Kabul Cargo: secrets (never commit this file) ---
SECRET_KEY=put-a-long-random-string-here
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

DB_NAME=kabulcargo
DB_USER=kabulcargo
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=3306

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# --- Security / production (stage 7) — all optional in development ---
# Reverse proxies in front of Django (nginx = 1). 0 = use REMOTE_ADDR only.
TRUSTED_PROXY_COUNT=0
# https://admin.example.com (production admin over HTTPS behind a proxy)
CSRF_TRUSTED_ORIGINS=
# redis://127.0.0.1:6379/1 — shared throttle counters in production (pip install redis)
REDIS_URL=
# Full path to mysqldump if it is not on PATH
MYSQLDUMP_PATH=
