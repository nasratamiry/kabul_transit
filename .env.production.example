# =============================================================================
# Kabul Cargo — production settings for docker-compose.yml
# Copy to `.env` next to docker-compose.yml (plain VPS), or paste into Coolify's
# "Environment Variables". Never commit the real file. Guide: docs/DEPLOY.md
# =============================================================================

# --- Domain -------------------------------------------------------------------
# The address people open, without https://. DNS A record → the server's IP.
DOMAIN=app.kabulcargo.com
# Same domain for Django (comma-separated if there are several, never "*").
ALLOWED_HOSTS=app.kabulcargo.com
# Full origins, with https://
CORS_ALLOWED_ORIGINS=https://app.kabulcargo.com
CSRF_TRUSTED_ORIGINS=https://app.kabulcargo.com
# Let's Encrypt notices (certificate expiry problems). Plain VPS only; Coolify asks itself.
LETSENCRYPT_EMAIL=it@kabulcargo.com

# --- Secrets (make each one new and random) -------------------------------------
# 50+ characters. Make one with:
#   docker run --rm python:3.12-slim python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
# Database password of the app user, and of MySQL's root user (different).
#   docker run --rm python:3.12-slim python -c "import secrets; print(secrets.token_urlsafe(32))"
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# --- Database (defaults are fine) -------------------------------------------------
DB_NAME=kabulcargo
DB_USER=kabulcargo

# --- Behaviour (defaults are fine) ------------------------------------------------
# Reverse proxies in front of Django: TLS proxy (Caddy / Coolify) + nginx = 2.
# Add one if Cloudflare (orange cloud) is also in front.
TRUSTED_PROXY_COUNT=2
# gunicorn worker processes: about 2 × CPU cores + 1 (3 for a 1-core server).
GUNICORN_WORKERS=3
# Login lifetime: access token in minutes, refresh token in days.
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7
# Daily backup: hour (Kabul time, 0–23) and how many days to keep.
BACKUP_HOUR=2
BACKUP_KEEP_DAYS=30

# KC_LOCAL_HTTP_TEST must NOT be set here. It is only for a local test of the stack
# (docker-compose.local.yml), and Django refuses to start with it on a real domain.
