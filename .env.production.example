# =============================================================================
# Kabul Cargo — production settings for docker-compose.yml
# Coolify: paste these into the resource's "Environment Variables" (Developer view), with real
# values. Plain VPS: copy to `.env` next to docker-compose.yml. Never commit the real values.
# Guide (Dari): docs/DEPLOY_COOLIFY.md
# =============================================================================

# --- Domain -------------------------------------------------------------------
# The address people open, without https:// and without a path. DNS A record → the server.
# Django's ALLOWED_HOSTS, CORS and CSRF origins are all made from this one value.
APP_DOMAIN=transit.kabulcargo.com

# Secret path of the Django admin panel (super admin only), e.g. kc-panel-<random>/ .
# Must not be admin/ (the app's own pages live under /admin/...), api/, static/ or media/.
# Make one with:  python -c "import secrets; print('kc-panel-' + secrets.token_hex(6) + '/')"
ADMIN_URL=

# --- Secrets (make each one new and random; never reuse another app's) ----------
# 50+ characters:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
# Database password of the app user, and of MySQL's root user (two different values):
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# --- Database (defaults are fine) -------------------------------------------------
DB_NAME=kabulcargo
DB_USER=kabulcargo

# --- Behaviour (defaults are fine) ------------------------------------------------
# Reverse proxies in front of Django: Coolify's proxy (TLS) + nginx = 2. Django trusts exactly
# that many X-Forwarded-For hops, so a client cannot fake its IP to dodge the login limits.
# Add one only if Cloudflare (orange cloud) is also put in front.
TRUSTED_PROXY_COUNT=2
# gunicorn worker processes. 3 fits the 768 MB memory limit of the backend container.
GUNICORN_WORKERS=3
# Login lifetime: access token in minutes, refresh token in days.
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7
# How many days of daily database backups to keep in the backups volume.
BACKUP_KEEP_DAYS=30

# --- Limits (defaults are sized for a branch office of ~10 people behind one IP) ---
# Failed logins per IP (= per office) per minute; each account still locks after 5 failures.
LOGIN_FAILURE_RATE=20/m
# Requests without login (login page, token refresh) per IP per minute.
THROTTLE_ANON_RATE=60/minute
# Requests per logged-in user per minute.
THROTTLE_USER_RATE=100/minute

# --- Plain VPS only (docker-compose.vps.yml; Coolify ignores these) ---------------
# Let's Encrypt notices about the certificate. Coolify asks for its own email.
LETSENCRYPT_EMAIL=
# Hour of the daily backup (Kabul time, 0–23). On Coolify the Scheduled Task sets the time.
BACKUP_HOUR=2

# KC_LOCAL_HTTP_TEST must NOT be set here. It is only for a local test of the stack
# (docker-compose.local.yml), and Django refuses to start with it on a real domain.
